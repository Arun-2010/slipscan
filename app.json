{
  "expo": {
    "name": "SlipScan",
    "slug": "slipscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "slipscan",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6F3",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "SlipScan uses the camera to photograph your bills.",
        "NSPhotoLibraryUsageDescription": "SlipScan lets you pick a bill photo from your gallery."
      }
    },
    "android": {
      "package": "com.arun.slipscan",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#123D2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#123D2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 104
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "SlipScan uses the camera to photograph your bills.",
          "photosPermission": "SlipScan lets you pick a bill photo from your gallery.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "31bbbe98-c15b-483c-89a6-642f67906779"
      }
    },
    "owner": "bandariaruns-team"
  }
}
